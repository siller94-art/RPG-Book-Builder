{
  "name": "rpg-book-builder",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "mac:xcode:check": "xcodebuild -version && xcrun --sdk macosx --show-sdk-path && rustc --version && npm test && npm run build",
    "mac:app": "npm run mac:xcode:check && npm run tauri -- build --bundles app",
    "mac:dmg": "npm run mac:xcode:check && npm run tauri -- build --bundles dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "jspdf": "^3.0.3",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0"
  }
}
